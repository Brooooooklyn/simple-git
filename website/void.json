{
  "$schema": "./node_modules/void/schema.json",
  "output": "server",
  "routing": {
    "revalidate": {
      "*": 0
    },
    "redirects": {
      "/docs/": {
        "to": "/docs",
        "status": 308
      }
    }
  },
  "head": {
    "titleTemplate": "%s | @napi-rs/simple-git",
    "htmlAttrs": {
      "lang": "en",
      "data-theme": "dark"
    },
    "meta": [
      { "name": "viewport", "content": "width=device-width, initial-scale=1" }
    ],
    "link": [
      { "rel": "icon", "href": "/favicon.svg" }
    ]
  },
  "worker": {
    "compatibility_date": "2026-02-24"
  }
}
